{
  "name": "changelog-studio",
  "displayName": "Changelog Studio",
  "description": "Visual Keep a Changelog release editor synchronized with Markdown.",
  "version": "0.1.0",
  "publisher": "changelog-studio",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "changelogStudio.open",
        "title": "Changelog Studio: Open Release Editor"
      },
      {
        "command": "changelogStudio.new",
        "title": "Changelog Studio: New Changelog"
      },
      {
        "command": "changelogStudio.recover",
        "title": "Changelog Studio: Recover Conflicting Draft"
      }
    ],
    "customEditors": [
      {
        "viewType": "changelogStudio.editor",
        "displayName": "Changelog Studio",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "changelogStudio.open",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "changelogStudio.open",
          "when": "resourceExtname == .md"
        }
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check.cjs && node --test tests/*.test.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "package": "node scripts/package.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vscode/vsce": "^3.6.0",
    "jsdom": "26.1.0"
  }
}
